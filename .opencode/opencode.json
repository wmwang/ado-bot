{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "default_agent": "dev",
  "tool_output": {
    "max_lines": 250,
    "max_bytes": 16384
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "permission": {
    "*": "allow",
    "question": "deny",
    "doom_loop": "deny"
  }
}
