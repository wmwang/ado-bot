{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "deny",
    "write": "deny",
    "bash": {
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "rm -rf *": "deny",
      "git push*": "deny",
      "*": "deny"
    },
    "task": {
      "explore": "allow",
      "*": "deny"
    }
  },
  "agent": {
    "explore": {
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5",
      "description": "唯讀程式碼庫探索專家：快速檢索現有架構、資料表 Schema、API 路由與設計慣例，並回傳精煉摘要",
      "prompt": "你是唯讀的程式碼探索子代理 (@explore)。請使用 glob、grep、read 快速查明主代理詢問的專案架構、模組位置、資料模型與命名慣例，最後僅回傳結構化的精煉摘要與關鍵檔案路徑，切勿傾倒整份原始碼。",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "deny"
      }
    },

    "clarify-agent-writer": {
      "mode": "primary",
      "description": "Stage 1 需求釐清撰寫者：讀取 ADO 卡片並結合現有架構產出 01_clarify.md",
      "prompt": "{file:./prompts/01-clarify-writer.md}",
      "permission": {
        "edit": {
          "docs/features/**": "allow",
          "*": "deny"
        },
        "write": {
          "docs/features/**": "allow",
          "*": "deny"
        }
      }
    },
    "clarify-agent-reviewer": {
      "mode": "primary",
      "description": "Stage 1 需求釐清審查員：審查 01_clarify.md 是否遺漏邊界條件或與現有系統衝突",
      "prompt": "{file:./prompts/01-clarify-reviewer.md}",
      "permission": {
        "edit": "deny",
        "write": "deny"
      }
    },

    "requirement-agent-writer": {
      "mode": "primary",
      "description": "Stage 2 需求規格撰寫者：根據 01_clarify.md 與人類回覆產出 02_requirements.md (含 Gherkin AC)",
      "prompt": "{file:./prompts/02-requirement-writer.md}",
      "permission": {
        "edit": {
          "docs/features/**": "allow",
          "*": "deny"
        },
        "write": {
          "docs/features/**": "allow",
          "*": "deny"
        }
      }
    },
    "requirement-agent-reviewer": {
      "mode": "primary",
      "description": "Stage 2 需求規格審查員：檢驗 User Story 與 Gherkin 驗收條件的可測試性與完整性",
      "prompt": "{file:./prompts/02-requirement-reviewer.md}",
      "permission": {
        "edit": "deny",
        "write": "deny"
      }
    },

    "contract-agent-writer": {
      "mode": "primary",
      "description": "Stage 3 介面契約撰寫者：根據 02_requirements.md 產出 OpenAPI 3.0 規格 03_openapi.yaml",
      "prompt": "{file:./prompts/03-contract-writer.md}",
      "permission": {
        "edit": {
          "docs/features/**": "allow",
          "*": "deny"
        },
        "write": {
          "docs/features/**": "allow",
          "*": "deny"
        },
        "bash": {
          "npx @redocly/cli lint*": "allow",
          "openapi-generator-cli validate*": "allow",
          "*": "deny"
        }
      }
    },
    "contract-agent-reviewer": {
      "mode": "primary",
      "description": "Stage 3 介面契約審查員：審查 03_openapi.yaml 的型別嚴謹度、錯誤碼定義與向下相容性",
      "prompt": "{file:./prompts/03-contract-reviewer.md}",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": {
          "npx @redocly/cli lint*": "allow",
          "openapi-generator-cli validate*": "allow",
          "*": "deny"
        }
      }
    },

    "scaffold-agent-writer": {
      "mode": "primary",
      "description": "Stage 4 程式碼實作撰寫者：根據 02_requirements.md 與 03_openapi.yaml 實作 src/ 業務邏輯",
      "prompt": "{file:./prompts/04-scaffold-writer.md}",
      "permission": {
        "edit": {
          "src/**": "allow",
          "app/**": "allow",
          "pkg/**": "allow",
          "internal/**": "allow",
          "docs/features/**": "deny",
          "*": "deny"
        },
        "write": {
          "src/**": "allow",
          "app/**": "allow",
          "pkg/**": "allow",
          "internal/**": "allow",
          "docs/features/**": "deny",
          "*": "deny"
        },
        "bash": {
          "python -m py_compile*": "allow",
          "ruff check*": "allow",
          "npm run build*": "allow",
          "npm run lint*": "allow",
          "go build*": "allow",
          "*": "deny"
        }
      }
    },
    "scaffold-agent-reviewer": {
      "mode": "primary",
      "description": "Stage 4 程式碼審查員：對照 OpenAPI 契約與現有架構規範進行 Code Review 與資安檢查",
      "prompt": "{file:./prompts/04-scaffold-reviewer.md}",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": {
          "git diff*": "allow",
          "python -m py_compile*": "allow",
          "ruff check*": "allow",
          "npm run lint*": "allow",
          "go vet*": "allow",
          "*": "deny"
        }
      }
    },

    "test-gen-agent-writer": {
      "mode": "primary",
      "description": "Stage 5 自動化測試撰寫者：對照 02_requirements.md 的 Gherkin AC 撰寫並執行 tests/ 單元與整合測試",
      "prompt": "{file:./prompts/05-test-writer.md}",
      "permission": {
        "edit": {
          "tests/**": "allow",
          "test/**": "allow",
          "*": "deny"
        },
        "write": {
          "tests/**": "allow",
          "test/**": "allow",
          "*": "deny"
        },
        "bash": {
          "pytest*": "allow",
          "python -m pytest*": "allow",
          "npm test*": "allow",
          "go test*": "allow",
          "*": "deny"
        }
      }
    },
    "test-gen-agent-reviewer": {
      "mode": "primary",
      "description": "Stage 5 測試品質審查員：檢查測試覆蓋率、邊界案例覆蓋度並驗證測試實際通過",
      "prompt": "{file:./prompts/05-test-reviewer.md}",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": {
          "pytest*": "allow",
          "python -m pytest*": "allow",
          "npm test*": "allow",
          "go test*": "allow",
          "*": "deny"
        }
      }
    }
  }
}
